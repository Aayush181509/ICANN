# =========================================================
# ICAN CA RAG Training — Environment Variables
# ---------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in the
# keys you actually have. You only need ONE provider key
# for the class to work end-to-end.
# =========================================================

# ---------- LLM provider API keys ----------
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google AI Studio / Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_key_here

# ---------- Default provider selection ----------
# Which provider should ask_llm() use when no model is passed?
# Allowed values: openai | anthropic | google | mock
LLM_PROVIDER=openai

# Default chat model per provider (override per call if needed)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_MODEL=gemini-1.5-flash

# ---------- Embeddings ----------
# Allowed values: local | openai
# - local  : uses sentence-transformers/all-MiniLM-L6-v2 (free, offline-friendly)
# - openai : uses OpenAI text-embedding-3-small (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Paths (rarely changed) ----------
RAG_DATA_DIR=data/generated
RAG_USER_DATA_DIR=data/user_data
RAG_OUTPUT_DIR=outputs
